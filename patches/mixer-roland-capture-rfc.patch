+/*
+ * A desktop refresh reads several related ALSA controls in succession.  Keep
+ * them on one coherent hardware snapshot instead of sending the full 1,146-byte
+ * request for every control family.  Write paths call the unthrottled locked
+ * reader directly, so confirmation readback is never served from this cache.
+ */
+static int roland_refresh_controls(struct roland_capture_mixer *private)
+{
+	int err;
+
+	if (private->last_control_refresh &&
+	    time_before(jiffies, private->last_control_refresh +
+			msecs_to_jiffies(ROLAND_CAPTURE_REFRESH_COALESCE_MS)))
+		return 0;
+	err = roland_octa_read_snapshot(private);
+	if (!err)
+		private->last_control_refresh = jiffies;
+	return err;
+}
+
+static int roland_snapshot_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+	int err;
+
+	err = roland_refresh_controls(private);
+	if (err < 0)
+		return err;
+	ucontrol->value.integer.value[0] = private->snapshot_generation & INT_MAX;
+	return 0;
+}
