+
+static int roland_octa_write_master_level_locked(
+	struct roland_capture_mixer *private, int kind, int mixer, u8 value)
+{
+	u8 message[19] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x08, mixer * 0x10, 0x01
+	};
+	int err;
+
+	switch (kind) {
+	case ROLAND_MASTER_INPUT_RIGHT:
+		message[9]++;
+		break;
+	case ROLAND_MASTER_OUTPUT_LEFT:
+		message[8] = 0x09;
+		break;
+	case ROLAND_MASTER_OUTPUT_RIGHT:
+		message[8] = 0x09;
+		message[9]++;
+		break;
+	case ROLAND_MASTER_REVERB_RETURN:
+		message[10] = 0x07;
+		break;
+	}
+	roland_encode_nibbles(roland_level_fixed[value], &message[11], 6);
+	message[17] = roland_checksum(&message[7], 10);
+	message[18] = 0xf7;
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+	return private->master_level[kind][mixer] == value ? 0 : -EIO;
