+static long roland_direct_value_get_cached(struct roland_capture_mixer *private,
+					   bool wave, int kind, int mixer,
+					   int channel)
+{
+	switch (kind) {
+	case ROLAND_DIRECT_PAN:
+		return wave ? private->wave_output_pan[mixer][channel] :
+			private->direct_input_pan[mixer][channel];
+	case ROLAND_DIRECT_LEVEL:
+		return wave ? private->wave_output_level[mixer][channel] :
+			private->direct_input_level[mixer][channel];
+	case ROLAND_DIRECT_REVERB_SEND:
+		return private->direct_input_reverb_send[channel];
+	default:
+		return 0;
+	}
+}
+
+static int roland_direct_value_info(struct snd_kcontrol *kcontrol,
+				    struct snd_ctl_elem_info *uinfo)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = elem->idx_off == ROLAND_DIRECT_PAN ? -100 : 0;
+	uinfo->value.integer.max = elem->idx_off == ROLAND_DIRECT_PAN ? 100 : 84;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int roland_direct_value_get(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	int mixer = elem->control / 10;
+	int channel = elem->control % 10;
+
+	ucontrol->value.integer.value[0] = roland_direct_value_get_cached(
+		private, elem->cmask, elem->idx_off, mixer, channel);
+	return 0;
+}
+
+static int roland_octa_write_direct_value_locked(
+	struct roland_capture_mixer *private, bool wave, int kind, int mixer,
+	int channel, long value)
+{
+	u8 message[19] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x06 + wave, mixer * 0x10 + channel, 0x00
+	};
+	int data_length;
+	int err;
+
+	switch (kind) {
+	case ROLAND_DIRECT_PAN:
+		message[10] = 0x04;
+		data_length = 4;
+		roland_encode_nibbles(16384 + 16384 * value / 100,
+				      &message[11], data_length);
+		break;
+	case ROLAND_DIRECT_LEVEL:
+		message[10] = 0x08;
+		data_length = 6;
+		roland_encode_nibbles(roland_level_fixed[value], &message[11],
+				      data_length);
+		break;
+	case ROLAND_DIRECT_REVERB_SEND:
+		message[10] = 0x0e;
+		data_length = 6;
+		roland_encode_nibbles(roland_level_fixed[value], &message[11],
+				      data_length);
+		break;
+	default:
+		return -EINVAL;
+	}
+	message[11 + data_length] =
+		roland_checksum(&message[7], 4 + data_length);
+	message[12 + data_length] = 0xf7;
+	err = roland_capture_midi_send(private, message, 13 + data_length);
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+
+	return roland_direct_value_get_cached(private, wave, kind, mixer, channel) ==
+	       value ?
+		0 : -EIO;
+}
+
+static int roland_direct_value_put(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	int mixer = elem->control / 10;
+	int channel = elem->control % 10;
+	long value = ucontrol->value.integer.value[0];
+	long minimum = elem->idx_off == ROLAND_DIRECT_PAN ? -100 : 0;
+	long maximum = elem->idx_off == ROLAND_DIRECT_PAN ? 100 : 84;
+	int err;
+
+	if (value < minimum || value > maximum)
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if (roland_direct_value_get_cached(private, elem->cmask, elem->idx_off,
+					  mixer, channel) == value)
+		return 0;
+	err = roland_octa_write_direct_value_locked(private, elem->cmask,
+						     elem->idx_off, mixer,
+						     channel, value);
+	return err < 0 ? err : 1;
+}
+
