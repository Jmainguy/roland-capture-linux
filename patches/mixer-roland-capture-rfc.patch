+static int roland_parameter_put(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	long value = ucontrol->value.integer.value[0];
+	int err;
+
+	if (value < 0 ||
+	    value > roland_compressor_parameter_max[elem->idx_off])
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if (private->compressor_parameter[elem->idx_off][elem->control] == value)
+		return 0;
+	err = roland_octa_write_parameter_locked(private, elem->idx_off,
+						  elem->control, value);
+	return err < 0 ? err : 1;
+}
