+static int roland_octa_write_direct_switch_locked(
+	struct roland_capture_mixer *private, bool wave, int kind, int mixer,
+	int channel, bool value)
+{
+	static const u8 offsets[] = { 0x00, 0x02, 0x03 };
+	u8 message[] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x06 + wave, mixer * 0x10 + channel, offsets[kind], value,
+		0x00, 0xf7
+	};
+	int err;
+
+	message[12] = roland_checksum(&message[7], 5);
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+
+	return (wave ? private->wave_output_switch[kind][mixer][channel] :
