diff --git a/sound/usb/mixer_roland_capture.c b/sound/usb/mixer_roland_capture.c
new file mode 100644
index 000000000..d40e4eff7
--- /dev/null
+++ b/sound/usb/mixer_roland_capture.c
@@ -0,0 +1,2372 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ALSA mixer support for Roland Capture USB audio interfaces
+ *
+ * The devices expose vendor-specific controls rather than a USB Audio Class
+ * mixer descriptor. Keep their control implementation separate from the
+ * descriptor and streaming quirks used by snd-usb-audio.
+ */
+
+#include <linux/slab.h>
+#include <linux/usb.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+
+#include <sound/tlv.h>
+#include <sound/control.h>
+#include <sound/core.h>
+#include <sound/rawmidi.h>
+
+#include "usbaudio.h"
+#include "mixer.h"
+#include "midi.h"
+#include "mixer_roland_capture.h"
+
+#define USB_ID_ROLAND_OCTA_CAPTURE USB_ID(0x0582, 0x0120)
+#define ROLAND_CAPTURE_MODEL_OCTA 0x4d
+#define ROLAND_CAPTURE_RESPONSE_MAX 2048
+#define ROLAND_CAPTURE_TIMEOUT_MS 1000
+#define ROLAND_CAPTURE_REFRESH_COALESCE_MS 500
+#define ROLAND_CAPTURE_CLOCK_INTERFACE 3
+#define ROLAND_CAPTURE_CLOCK_ENDPOINT 0x82
+#define ROLAND_CAPTURE_CLOCK_PACKET_SIZE 8
+
+static const u8 roland_octa_load_request[] = {
+	0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x11,
+	0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x7a, 0x7d, 0xf7
+};
+
+struct roland_capture_mixer {
+	struct usb_mixer_interface *mixer;
+	struct snd_rawmidi_file midi_file;
+	struct mutex request_mutex;
+	spinlock_t response_lock;
+	struct completion response_ready;
+	bool waiting;
+	u8 expected_address[4];
+	u8 response[ROLAND_CAPTURE_RESPONSE_MAX];
+	size_t response_length;
+	u8 meter_response[256];
+	size_t meter_response_length;
+	u16 input_meter[8];
+	u16 compressor_output_meter[8];
+	bool meter_streaming;
+	struct delayed_work meter_stream_timeout;
+	u8 gain[8];
+	bool phantom[8];
+	bool low_cut[8];
+	bool phase[8];
+	bool high_impedance[2];
+	bool compressor[8];
+	bool compressor_stereo_link[4];
+	u8 compressor_parameter[6][8];
+	bool direct_input_switch[3][4][10];
+	bool wave_output_switch[3][4][10];
+	s16 direct_input_pan[4][10];
+	s16 wave_output_pan[4][10];
+	u8 direct_input_level[4][10];
+	u8 wave_output_level[4][10];
+	u8 direct_input_reverb_send[10];
+	bool master_switch[3][4];
+	u8 master_level[5][4];
+	u8 patch_bay[5];
+	u8 reverb_type;
+	u8 reverb_pre_delay;
+	u8 reverb_time;
+	u8 device_globals[5];
+	bool auto_sens_selected[8];
+	u8 auto_sens_state;
+	u32 snapshot_generation;
+	unsigned long last_control_refresh;
+	struct urb *clock_urb;
+	u8 *clock_buffer;
+	bool clock_valid;
+	bool clock_external;
+	bool clock_locked;
+	u8 clock_rate_flag;
+	u32 clock_external_hz;
+	u8 model_id;
+};
+
+static void roland_clock_complete(struct urb *urb)
+{
+	struct roland_capture_mixer *private = urb->context;
+	unsigned long flags;
+	int err;
+
+	if (!urb->status && urb->actual_length == ROLAND_CAPTURE_CLOCK_PACKET_SIZE &&
+	    private->clock_buffer[1] == 0 &&
+	    !(private->clock_buffer[2] & ~1)) {
+		spin_lock_irqsave(&private->response_lock, flags);
+		private->clock_rate_flag = private->clock_buffer[2] & 1;
+		private->clock_external_hz = private->clock_buffer[3] |
+			(private->clock_buffer[4] << 8) |
+			(private->clock_buffer[5] << 16);
+		private->clock_external = private->clock_buffer[6] != 0;
+		private->clock_locked = private->clock_buffer[7] != 0;
+		private->clock_valid = true;
+		spin_unlock_irqrestore(&private->response_lock, flags);
+	}
+
+	if (urb->status == -ENOENT || urb->status == -ECONNRESET ||
+	    urb->status == -ESHUTDOWN)
+		return;
+	err = usb_submit_urb(urb, GFP_ATOMIC);
+	if (err)
+		usb_audio_warn(private->mixer->chip,
+			       "cannot resubmit OCTA clock telemetry URB: %d\n", err);
+}
+
+static int roland_clock_start(struct roland_capture_mixer *private)
+{
+	struct usb_device *dev = private->mixer->chip->dev;
+	int err;
+
+	err = usb_set_interface(dev, ROLAND_CAPTURE_CLOCK_INTERFACE, 1);
+	if (err < 0)
+		return err;
+	private->clock_urb = usb_alloc_urb(0, GFP_KERNEL);
+	private->clock_buffer = kmalloc(ROLAND_CAPTURE_CLOCK_PACKET_SIZE, GFP_KERNEL);
+	if (!private->clock_urb || !private->clock_buffer) {
+		usb_free_urb(private->clock_urb);
+		private->clock_urb = NULL;
+		kfree(private->clock_buffer);
+		private->clock_buffer = NULL;
+		return -ENOMEM;
+	}
+	usb_fill_int_urb(private->clock_urb, dev,
+			 usb_rcvintpipe(dev, ROLAND_CAPTURE_CLOCK_ENDPOINT),
+			 private->clock_buffer, ROLAND_CAPTURE_CLOCK_PACKET_SIZE,
+			 roland_clock_complete, private, 1);
+	return usb_submit_urb(private->clock_urb, GFP_KERNEL);
+}
+
+static int roland_clock_info(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 5;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 0xffffff;
+	return 0;
+}
+
+static int roland_clock_get(struct snd_kcontrol *kcontrol,
+			    struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+	unsigned long flags;
+
+	spin_lock_irqsave(&private->response_lock, flags);
+	ucontrol->value.integer.value[0] = private->clock_valid;
+	ucontrol->value.integer.value[1] = private->clock_external;
+	ucontrol->value.integer.value[2] = private->clock_locked;
+	ucontrol->value.integer.value[3] = private->clock_external_hz;
+	ucontrol->value.integer.value[4] = private->clock_rate_flag;
+	spin_unlock_irqrestore(&private->response_lock, flags);
+	return 0;
+}
+
+static const struct snd_kcontrol_new roland_clock_control = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "Clock State",
+	.access = SNDRV_CTL_ELEM_ACCESS_READ | SNDRV_CTL_ELEM_ACCESS_VOLATILE,
+	.info = roland_clock_info,
+	.get = roland_clock_get,
+};
+
+enum roland_preamp_switch {
+	ROLAND_SWITCH_PHANTOM,
+	ROLAND_SWITCH_LOW_CUT,
+	ROLAND_SWITCH_PHASE,
+	ROLAND_SWITCH_HIGH_IMPEDANCE,
+	ROLAND_SWITCH_COMPRESSOR,
+};
+
+enum roland_compressor_parameter {
+	ROLAND_COMP_GATE,
+	ROLAND_COMP_ATTACK,
+	ROLAND_COMP_RELEASE,
+	ROLAND_COMP_THRESHOLD,
+	ROLAND_COMP_RATIO,
+	ROLAND_COMP_OUTPUT_GAIN,
+};
+
+enum roland_direct_switch {
+	ROLAND_DIRECT_STEREO_LINK,
+	ROLAND_DIRECT_SOLO,
+	ROLAND_DIRECT_MUTE,
+};
+
+enum roland_direct_value {
+	ROLAND_DIRECT_PAN,
+	ROLAND_DIRECT_LEVEL,
+	ROLAND_DIRECT_REVERB_SEND,
+};
+
+enum roland_master_switch {
+	ROLAND_MASTER_INPUT_STEREO_LINK,
+	ROLAND_MASTER_LINK_INPUT_OUTPUT,
+	ROLAND_MASTER_OUTPUT_STEREO_LINK,
+};
+
+enum roland_master_level {
+	ROLAND_MASTER_INPUT_LEFT,
+	ROLAND_MASTER_INPUT_RIGHT,
+	ROLAND_MASTER_OUTPUT_LEFT,
+	ROLAND_MASTER_OUTPUT_RIGHT,
+	ROLAND_MASTER_REVERB_RETURN,
+};
+
+enum roland_reverb_control {
+	ROLAND_REVERB_PRE_DELAY,
+	ROLAND_REVERB_TIME,
+};
+
+static const u8 roland_compressor_parameter_max[] = {
+	[ROLAND_COMP_GATE] = 50,
+	[ROLAND_COMP_ATTACK] = 124,
+	[ROLAND_COMP_RELEASE] = 124,
+	[ROLAND_COMP_THRESHOLD] = 40,
+	[ROLAND_COMP_RATIO] = 13,
+	[ROLAND_COMP_OUTPUT_GAIN] = 80,
+};
+
+static const u32 roland_level_fixed[] = {
+	0, 591, 663, 744, 835, 937, 1051, 1179,
+	1323, 1485, 1666, 1869, 2097, 2353, 2640, 2962,
+	3324, 3729, 4184, 4695, 5268, 5911, 6632, 7441,
+	8349, 9368, 10511, 11793, 13232, 14847, 16658, 18691,
+	20972, 23530, 26402, 29623, 33238, 37293, 41844, 46949,
+	52678, 59106, 66318, 74410, 83489, 93676, 105107, 117932,
+	132321, 148467, 166583, 186909, 209715, 235304, 264016, 296231,
+	332376, 372932, 418437, 469494, 526781, 591058, 663178, 744098,
+	834891, 936763, 1051066, 1179315, 1323213, 1484670, 1665827,
+	1869089, 2097152, 2353043, 2640158, 2962306, 3323762, 3729322,
+	4184368, 4694939, 5267808, 5910577, 6631777, 7440976, 8348912,
+};
+
+static bool roland_grouped(const u8 *data, int offset, int channel)
+{
+	return data[offset + channel / 4] & BIT(channel % 4);
+}
+
+static bool roland_direct_stereo_link(const u8 *data, int mixer, int channel)
+{
+	int pair = channel / 2;
+
+	return data[88 + mixer * 2 + (pair >= 4)] & BIT(pair < 4 ? pair : 0);
+}
+
+static bool roland_wave_stereo_link(const u8 *data, int mixer, int channel)
+{
+	int pair = channel / 2;
+
+	return data[588 + mixer * 2 + (pair >= 4)] & BIT(pair < 4 ? pair : 0);
+}
+
+static u32 roland_nibbles(const u8 *data, int length)
+{
+	u32 value = 0;
+
+	while (length--)
+		value = value << 4 | *data++;
+	return value;
+}
+
+static u8 roland_decode_level(const u8 *data)
+{
+	u32 fixed = roland_nibbles(data, 6);
+	u32 best_difference = U32_MAX;
+	int best = 0;
+	int raw;
+
+	if (!fixed)
+		return 0;
+	for (raw = 1; raw < ARRAY_SIZE(roland_level_fixed); raw++) {
+		u32 candidate = roland_level_fixed[raw];
+		u32 difference = fixed > candidate ?
+			fixed - candidate : candidate - fixed;
+
+		if (difference < best_difference) {
+			best_difference = difference;
+			best = raw;
+		}
+	}
+	return best;
+}
+
+static void roland_encode_nibbles(u32 value, u8 *data, int length)
+{
+	while (length--) {
+		data[length] = value & 0x0f;
+		value >>= 4;
+	}
+}
+
+static bool roland_capture_response_valid(struct roland_capture_mixer *private)
+{
+	u8 sum = 0;
+	size_t i;
+
+	if (private->response_length < 13 || private->response[0] != 0xf0 ||
+	    private->response[1] != 0x41 || private->response[2] != 0x10 ||
+	    private->response[5] != private->model_id ||
+	    private->response[6] != 0x12 ||
+	    private->response[private->response_length - 1] != 0xf7 ||
+	    memcmp(&private->response[7], private->expected_address, 4))
+		return false;
+
+	for (i = 7; i < private->response_length - 1; i++)
+		sum += private->response[i];
+
+	return !(sum & 0x7f);
+}
+
+static void roland_capture_parse_meter(struct roland_capture_mixer *private,
+				       const u8 *message, size_t message_length)
+{
+	static const u8 input_address[] = { 0x00, 0x0a, 0x00, 0x01 };
+	static const u8 output_address[] = { 0x00, 0x0a, 0x00, 0x11 };
+	const u8 *payload = &message[11];
+	size_t payload_length = message_length - 13;
+	int channel;
+
+	if (message[0] != 0xf0 || message[1] != 0x41 ||
+	    message[5] != private->model_id || message[6] != 0x12)
+		return;
+	if (!memcmp(&message[7], input_address, 4) && payload_length >= 16) {
+		for (channel = 0; channel < 8; channel++)
+			private->input_meter[channel] =
+				(payload[channel * 2] << 7) | payload[channel * 2 + 1];
+		if (payload_length < 32)
+			return;
+		payload += 16;
+	} else if (!memcmp(&message[7], output_address, 4) &&
+		   payload_length >= 16) {
+		/* A split post-compressor frame already starts at its payload. */
+	} else {
+		return;
+	}
+	for (channel = 0; channel < 8; channel++)
+		private->compressor_output_meter[channel] =
+			(payload[channel * 2] << 7) | payload[channel * 2 + 1];
+}
+
+static void roland_capture_midi_input(struct roland_capture_mixer *private,
+				      const u8 *data, size_t length)
+{
+	unsigned long flags;
+	bool ready = false;
+	size_t i;
+
+	spin_lock_irqsave(&private->response_lock, flags);
+	for (i = 0; i < length; i++) {
+		if (data[i] == 0xf0)
+			private->meter_response_length = 0;
+		if (private->meter_response_length < sizeof(private->meter_response))
+			private->meter_response[private->meter_response_length++] = data[i];
+		else
+			private->meter_response_length = 0;
+		if (data[i] == 0xf7 && private->meter_response_length >= 13) {
+			const u8 *message = private->meter_response;
+			size_t message_length = private->meter_response_length;
+
+			roland_capture_parse_meter(private, message, message_length);
+			private->meter_response_length = 0;
+		}
+
+		if (!private->waiting)
+			continue;
+		if (data[i] == 0xf0)
+			private->response_length = 0;
+		if (private->response_length >= sizeof(private->response)) {
+			private->waiting = false;
+			goto unlock;
+		}
+		private->response[private->response_length++] = data[i];
+		if (data[i] == 0xf7) {
+			if (roland_capture_response_valid(private)) {
+				private->waiting = false;
+				ready = true;
+				break;
+			}
+			private->response_length = 0;
+		}
+	}
+
+unlock:
+	spin_unlock_irqrestore(&private->response_lock, flags);
+	if (ready)
+		complete(&private->response_ready);
+}
+
+static void roland_capture_midi_event(struct snd_rawmidi_substream *substream)
+{
+	struct roland_capture_mixer *private = substream->runtime->private_data;
+	u8 data[256];
+	long length;
+
+	do {
+		length = snd_rawmidi_kernel_read(substream, data, sizeof(data));
+		if (length > 0)
+			roland_capture_midi_input(private, data, length);
+	} while (length > 0);
+}
+
+static struct snd_rawmidi *roland_capture_find_rawmidi(struct snd_card *card)
+{
+	struct snd_device *device;
+
+	list_for_each_entry(device, &card->devices, list)
+		if (device->type == SNDRV_DEV_RAWMIDI)
+			return device->device_data;
+
+	return NULL;
+}
+
+static int roland_capture_midi_open(struct roland_capture_mixer *private)
+{
+	struct snd_rawmidi_params params = {
+		.buffer_size = 4096,
+		.avail_min = 1,
+		.no_active_sensing = 1,
+	};
+	struct snd_rawmidi *rmidi;
+	int err;
+
+	rmidi = roland_capture_find_rawmidi(private->mixer->chip->card);
+	if (!rmidi)
+		return -ENODEV;
+
+	/*
+	 * The fixed endpoint exposes cable 0 as subdevice 0.  OCTA control
+	 * traffic uses host cable 2 and device cable 1, which are each the
+	 * second populated cable and therefore raw-MIDI subdevice 1.
+	 */
+	err = snd_rawmidi_kernel_open(rmidi, 1, SNDRV_RAWMIDI_LFLG_INPUT |
+				      SNDRV_RAWMIDI_LFLG_OUTPUT,
+				      &private->midi_file);
+	if (err < 0)
+		return err;
+
+	err = snd_rawmidi_input_params(private->midi_file.input, &params);
+	if (err < 0)
+		goto release;
+	err = snd_rawmidi_output_params(private->midi_file.output, &params);
+	if (err < 0)
+		goto release;
+
+	private->midi_file.input->runtime->event = roland_capture_midi_event;
+	private->midi_file.input->runtime->private_data = private;
+	snd_rawmidi_kernel_read(private->midi_file.input, NULL, 0);
+	return 0;
+
+release:
+	snd_rawmidi_kernel_release(&private->midi_file);
+	private->midi_file = (struct snd_rawmidi_file){};
+	return err;
+}
+
+static void roland_capture_midi_close(struct roland_capture_mixer *private)
+{
+	if (!private->midi_file.rmidi)
+		return;
+	private->midi_file.input->runtime->event = NULL;
+	private->midi_file.input->runtime->private_data = NULL;
+	snd_rawmidi_kernel_release(&private->midi_file);
+	private->midi_file = (struct snd_rawmidi_file){};
+}
+
+static int roland_capture_midi_send(struct roland_capture_mixer *private,
+				     const u8 *data, size_t length)
+{
+	bool opened_here = !private->midi_file.rmidi;
+	long written;
+	int err;
+
+	if (opened_here) {
+		err = roland_capture_midi_open(private);
+		if (err < 0)
+			return err;
+	}
+	written = snd_rawmidi_kernel_write(private->midi_file.output, data, length);
+	if (written < 0)
+		err = written;
+	else if (written != length)
+		err = -EIO;
+	else
+		err = 0;
+	if (opened_here) {
+		if (!err)
+			err = snd_rawmidi_drain_output(private->midi_file.output);
+		roland_capture_midi_close(private);
+	}
+	return err;
+}
+
+static int roland_capture_request(struct roland_capture_mixer *private,
+				  const u8 *request, size_t request_length,
+				  const u8 expected_address[4])
+{
+	bool opened_here = !private->midi_file.rmidi;
+	unsigned long flags;
+	long completed;
+	int err;
+
+	if (opened_here) {
+		err = roland_capture_midi_open(private);
+		if (err < 0)
+			return err;
+	}
+
+	reinit_completion(&private->response_ready);
+	spin_lock_irqsave(&private->response_lock, flags);
+	memcpy(private->expected_address, expected_address, 4);
+	private->response_length = 0;
+	private->waiting = true;
+	spin_unlock_irqrestore(&private->response_lock, flags);
+
+	err = roland_capture_midi_send(private, request, request_length);
+	if (err < 0)
+		goto cancel;
+
+	completed = wait_for_completion_interruptible_timeout(
+		&private->response_ready,
+		msecs_to_jiffies(ROLAND_CAPTURE_TIMEOUT_MS));
+	if (completed > 0) {
+		err = 0;
+		goto close;
+	}
+	err = completed < 0 ? completed : -ETIMEDOUT;
+
+cancel:
+	spin_lock_irqsave(&private->response_lock, flags);
+	private->waiting = false;
+	spin_unlock_irqrestore(&private->response_lock, flags);
+
+close:
+	if (opened_here)
+		roland_capture_midi_close(private);
+	return err;
+}
+
+static int roland_octa_read_snapshot_locked(struct roland_capture_mixer *private)
+{
+	static const u8 address[4] = { 0x01, 0x00, 0x00, 0x00 };
+	int err;
+	int channel;
+
+	err = roland_capture_request(private, roland_octa_load_request,
+				     sizeof(roland_octa_load_request), address);
+	if (err < 0)
+		return err;
+	if (private->response_length < 48)
+		return -EIO;
+
+	memcpy(private->device_globals, &private->response[11],
+	       sizeof(private->device_globals));
+
+	for (channel = 0; channel < ARRAY_SIZE(private->gain); channel++)
+		private->gain[channel] = private->response[11 + 29 + channel];
+	for (channel = 0; channel < ARRAY_SIZE(private->gain); channel++) {
+		const u8 *data = &private->response[11];
+		int parameter;
+
+		private->phantom[channel] = roland_grouped(data, 21, channel);
+		private->low_cut[channel] = roland_grouped(data, 23, channel);
+		private->phase[channel] = roland_grouped(data, 25, channel);
+		private->compressor[channel] = !roland_grouped(data, 38, channel);
+		if (channel < ARRAY_SIZE(private->high_impedance))
+			private->high_impedance[channel] = data[27] & BIT(channel);
+		for (parameter = 0;
+		     parameter < ARRAY_SIZE(private->compressor_parameter);
+		     parameter++)
+			private->compressor_parameter[parameter][channel] =
+				data[40 + parameter * 8 + channel];
+	}
+	for (channel = 0; channel < ARRAY_SIZE(private->compressor_stereo_link);
+	     channel++)
+		private->compressor_stereo_link[channel] =
+			private->response[11 + 37] & BIT(channel);
+	for (channel = 0; channel < 4 * 10; channel++) {
+		const u8 *data = &private->response[11];
+		int mixer = channel / 10;
+		int input = channel % 10;
+
+		private->direct_input_switch[ROLAND_DIRECT_STEREO_LINK]
+			[mixer][input] = roland_direct_stereo_link(data, mixer, input);
+		private->direct_input_switch[ROLAND_DIRECT_SOLO][mixer][input] =
+			roland_grouped(data, 104 + mixer * 3, input);
+		private->direct_input_switch[ROLAND_DIRECT_MUTE][mixer][input] =
+			roland_grouped(data, 116 + mixer * 3, input);
+		private->direct_input_pan[mixer][input] = DIV_ROUND_CLOSEST(
+			((s32)roland_nibbles(&data[128 + channel * 4], 4) - 16384) * 100,
+			16384);
+		private->direct_input_level[mixer][input] =
+			roland_decode_level(&data[288 + channel * 6]);
+		if (!mixer)
+			private->direct_input_reverb_send[input] =
+				roland_decode_level(&data[528 + input * 6]);
+		private->wave_output_switch[ROLAND_DIRECT_STEREO_LINK]
+			[mixer][input] = roland_wave_stereo_link(data, mixer, input);
+		private->wave_output_switch[ROLAND_DIRECT_SOLO][mixer][input] =
+			roland_grouped(data, 604 + mixer * 3, input);
+		private->wave_output_switch[ROLAND_DIRECT_MUTE][mixer][input] =
+			roland_grouped(data, 616 + mixer * 3, input);
+		private->wave_output_pan[mixer][input] = DIV_ROUND_CLOSEST(
+			((s32)roland_nibbles(&data[628 + channel * 4], 4) - 16384) * 100,
+			16384);
+		private->wave_output_level[mixer][input] =
+			roland_decode_level(&data[788 + channel * 6]);
+	}
+	for (channel = 0; channel < 4; channel++) {
+		const u8 *data = &private->response[11];
+
+		private->master_switch[ROLAND_MASTER_INPUT_STEREO_LINK][channel] =
+			data[1028 + channel];
+		private->master_level[ROLAND_MASTER_INPUT_LEFT][channel] =
+			roland_decode_level(&data[1032 + channel * 12]);
+		private->master_level[ROLAND_MASTER_INPUT_RIGHT][channel] =
+			roland_decode_level(&data[1038 + channel * 12]);
+		private->master_switch[ROLAND_MASTER_LINK_INPUT_OUTPUT][channel] =
+			data[1086 + channel];
+		private->master_switch[ROLAND_MASTER_OUTPUT_STEREO_LINK][channel] =
+			data[1094 + channel];
+		private->master_level[ROLAND_MASTER_OUTPUT_LEFT][channel] =
+			roland_decode_level(&data[1098 + channel * 12]);
+		private->master_level[ROLAND_MASTER_OUTPUT_RIGHT][channel] =
+			roland_decode_level(&data[1104 + channel * 12]);
+	}
+	private->master_level[ROLAND_MASTER_REVERB_RETURN][0] =
+		roland_decode_level(&private->response[11 + 1080]);
+	for (channel = 0; channel < ARRAY_SIZE(private->patch_bay); channel++)
+		private->patch_bay[channel] = private->response[11 + 5 + channel];
+	private->reverb_type = private->response[11 + 10];
+	if (private->reverb_type >= 1 && private->reverb_type <= 5) {
+		private->reverb_pre_delay =
+			private->response[11 + 11 + private->reverb_type - 1];
+		private->reverb_time =
+			private->response[11 + 16 + private->reverb_type - 1];
+	} else {
+		private->reverb_pre_delay = 0;
+		private->reverb_time = 0;
+	}
+	private->snapshot_generation++;
+
+	return 0;
+}
+
+static int roland_octa_read_snapshot(struct roland_capture_mixer *private)
+{
+	guard(mutex)(&private->request_mutex);
+
+	return roland_octa_read_snapshot_locked(private);
+}
+
+static u8 roland_checksum(const u8 *data, size_t length)
+{
+	u8 sum = 0;
+
+	while (length--)
+		sum += *data++;
+
+	return -sum & 0x7f;
+}
+
+static int roland_octa_send_byte_locked(struct roland_capture_mixer *private,
+					u8 address_1, u8 address_2,
+					u8 address_3, u8 value)
+{
+	u8 message[] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, address_1, address_2, address_3, value, 0x00, 0xf7
+	};
+
+	int err;
+
+	message[12] = roland_checksum(&message[7], 5);
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	usleep_range(5000, 6000);
+	return 0;
+}
+
+static void roland_meter_stream_timeout(struct work_struct *work)
+{
+	struct roland_capture_mixer *private = container_of(
+		to_delayed_work(work), struct roland_capture_mixer,
+		meter_stream_timeout);
+
+	guard(mutex)(&private->request_mutex);
+	if (!private->meter_streaming)
+		return;
+	if (!roland_octa_send_byte_locked(private, 0x0a, 0x00, 0x00, 0)) {
+		private->meter_streaming = false;
+		roland_capture_midi_close(private);
+	}
+}
+
+static int roland_octa_write_gain_locked(struct roland_capture_mixer *private,
+					 int channel, u8 value)
+{
+	u8 message[] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x05, channel, 0x04, value, 0x00, 0xf7
+	};
+	int err;
+
+	message[12] = roland_checksum(&message[7], 5);
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+
+	return private->gain[channel] == value ? 0 : -EIO;
+}
+
+static bool roland_switch_value(struct roland_capture_mixer *private,
+				int kind, int channel)
+{
+	switch (kind) {
+	case ROLAND_SWITCH_PHANTOM:
+		return private->phantom[channel];
+	case ROLAND_SWITCH_LOW_CUT:
+		return private->low_cut[channel];
+	case ROLAND_SWITCH_PHASE:
+		return private->phase[channel];
+	case ROLAND_SWITCH_HIGH_IMPEDANCE:
+		return private->high_impedance[channel];
+	case ROLAND_SWITCH_COMPRESSOR:
+		return private->compressor[channel];
+	default:
+		return false;
+	}
+}
+
+static u8 roland_switch_offset(int kind)
+{
+	static const u8 offsets[] = { 0x00, 0x01, 0x02, 0x03, 0x06 };
+
+	return offsets[kind];
+}
+
+static int roland_octa_write_switch_locked(struct roland_capture_mixer *private,
+					   int kind, int channel, bool value)
+{
+	u8 wire_value = kind == ROLAND_SWITCH_COMPRESSOR ? !value : value;
+	u8 message[] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x05, channel, roland_switch_offset(kind), wire_value,
+		0x00, 0xf7
+	};
+	int err;
+
+	message[12] = roland_checksum(&message[7], 5);
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+
+	return roland_switch_value(private, kind, channel) == value ? 0 : -EIO;
+}
+
+static int roland_switch_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+
+	ucontrol->value.integer.value[0] =
+		roland_switch_value(private, elem->idx_off, elem->control);
+	return 0;
+}
+
+static int roland_switch_put(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	long value = ucontrol->value.integer.value[0];
+	int err;
+
+	if (value < 0 || value > 1)
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if (roland_switch_value(private, elem->idx_off, elem->control) == value)
+		return 0;
+	err = roland_octa_write_switch_locked(private, elem->idx_off,
+					       elem->control,
+					       value);
+	return err < 0 ? err : 1;
+}
+
+static const struct snd_kcontrol_new roland_switch_control = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.info = snd_ctl_boolean_mono_info,
+	.get = roland_switch_get,
+	.put = roland_switch_put,
+};
+
+static int roland_compressor_link_get(struct snd_kcontrol *kcontrol,
+				      struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+
+	ucontrol->value.integer.value[0] =
+		private->compressor_stereo_link[elem->control];
+	return 0;
+}
+
+static int roland_compressor_link_put(struct snd_kcontrol *kcontrol,
+				      struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	long value = ucontrol->value.integer.value[0];
+	int err;
+
+	if (value < 0 || value > 1)
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if (private->compressor_stereo_link[elem->control] == value)
+		return 0;
+	err = roland_octa_send_byte_locked(private, 0x05, elem->control * 2,
+					   0x05, value);
+	if (err < 0)
+		return err;
+	usleep_range(10000, 12000);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+	return private->compressor_stereo_link[elem->control] == value ? 1 : -EIO;
+}
+
+static const struct snd_kcontrol_new roland_compressor_link_control = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.info = snd_ctl_boolean_mono_info,
+	.get = roland_compressor_link_get,
+	.put = roland_compressor_link_put,
+};
+
+static int roland_parameter_info(struct snd_kcontrol *kcontrol,
+				 struct snd_ctl_elem_info *uinfo)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = roland_compressor_parameter_max[elem->idx_off];
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int roland_parameter_get(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+
+	ucontrol->value.integer.value[0] =
+		private->compressor_parameter[elem->idx_off][elem->control];
+	return 0;
+}
+
+static int roland_octa_write_parameter_locked(
+	struct roland_capture_mixer *private, int parameter, int channel, u8 value)
+{
+	u8 message[] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x05, channel, 0x07 + parameter, value, 0x00, 0xf7
+	};
+	int err;
+
+	message[12] = roland_checksum(&message[7], 5);
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+
+	return private->compressor_parameter[parameter][channel] == value ?
+		0 : -EIO;
+}
