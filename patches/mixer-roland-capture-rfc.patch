+static int roland_meter_stream_get(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.integer.value[0] = private->meter_streaming;
+	return 0;
+}
+
+static int roland_meter_stream_put(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+	bool enabled = !!ucontrol->value.integer.value[0];
+	int err;
+
+	if (enabled) {
+		guard(mutex)(&private->request_mutex);
+		if (!private->meter_streaming) {
+			err = roland_capture_midi_open(private);
+			if (err < 0)
+				return err;
+			err = roland_octa_send_byte_locked(private, 0x0a, 0x00,
+							    0x00, 1);
+			if (err < 0) {
+				roland_capture_midi_close(private);
+				return err;
+			}
+			private->meter_streaming = true;
+		}
+		mod_delayed_work(system_wq, &private->meter_stream_timeout,
+				 msecs_to_jiffies(1000));
+		return 1;
+	}
+
+	cancel_delayed_work(&private->meter_stream_timeout);
+	guard(mutex)(&private->request_mutex);
+	if (!private->meter_streaming)
+		return 0;
+	err = roland_octa_send_byte_locked(private, 0x0a, 0x00, 0x00, 0);
+	if (err < 0)
+		return err;
+	private->meter_streaming = false;
+	roland_capture_midi_close(private);
+	return 1;
+}
