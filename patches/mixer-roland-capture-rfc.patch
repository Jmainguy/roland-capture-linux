+static int roland_octa_write_reverb_locked(
+	struct roland_capture_mixer *private, int kind, u8 value)
+{
+	u8 message[] = {
+		0xf0, 0x41, 0x10, 0x00, 0x00, ROLAND_CAPTURE_MODEL_OCTA, 0x12,
+		0x00, 0x04, 0x00, 0x00, value, 0x00, 0xf7
+	};
+	int err;
+
+	if (kind >= 0) {
+		if (!private->reverb_type)
+			return -EINVAL;
+		/* Snapshot type is 1..5; parameter banks are addressed 0..4. */
+		message[9] = private->reverb_type - 1;
+		message[10] = kind == ROLAND_REVERB_PRE_DELAY ? 0x01 : 0x02;
+	}
+	message[12] = roland_checksum(&message[7], 5);
+	err = roland_capture_midi_send(private, message, sizeof(message));
+	if (err < 0)
+		return err;
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	if (err < 0)
+		return err;
+	if (kind < 0)
+		return private->reverb_type == value ? 0 : -EIO;
+	return (kind == ROLAND_REVERB_PRE_DELAY ? private->reverb_pre_delay :
+		private->reverb_time) == value ? 0 : -EIO;
+}
+
+static int roland_reverb_type_put(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+	unsigned int value = ucontrol->value.enumerated.item[0];
+	int err;
+
+	if (value > 5)
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if (private->reverb_type == value)
+		return 0;
+	err = roland_octa_write_reverb_locked(private, -1, value);
+	return err < 0 ? err : 1;
+}
