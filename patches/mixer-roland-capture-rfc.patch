+static int roland_reverb_parameter_get(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+
+	ucontrol->value.integer.value[0] = elem->control == ROLAND_REVERB_PRE_DELAY ?
+		private->reverb_pre_delay : private->reverb_time;
+	return 0;
+}
+
+static int roland_reverb_parameter_put(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	long value = ucontrol->value.integer.value[0];
+	u8 current_value;
+	int err;
+
+	if (value < 0 || value >
+		(elem->control == ROLAND_REVERB_PRE_DELAY ? 12 : 49))
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	current_value = elem->control == ROLAND_REVERB_PRE_DELAY ?
+		private->reverb_pre_delay : private->reverb_time;
+	if (current_value == value)
+		return 0;
+	err = roland_octa_write_reverb_locked(private, elem->control, value);
+	return err < 0 ? err : 1;
+}
