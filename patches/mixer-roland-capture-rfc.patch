+static int roland_auto_sens_state_info(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_info *uinfo)
+{
+	static const char * const names[] = { "Off", "Running", "Cancel" };
+
+	return snd_ctl_enum_info(uinfo, 1, ARRAY_SIZE(names), names);
+}
+
+static int roland_auto_sens_state_get(struct snd_kcontrol *kcontrol,
+				      struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+
+	ucontrol->value.enumerated.item[0] = private->auto_sens_state;
+	return 0;
+}
+
+static int roland_auto_sens_state_put(struct snd_kcontrol *kcontrol,
+				      struct snd_ctl_elem_value *ucontrol)
+{
+	struct roland_capture_mixer *private = snd_kcontrol_chip(kcontrol);
+	unsigned int value = ucontrol->value.enumerated.item[0];
+	int channel;
+	int err;
+
+	if (value > 2)
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if (value == 1) {
+		bool any = false;
+
+		if (private->auto_sens_state)
+			return 0;
+		for (channel = 0; channel < ARRAY_SIZE(private->auto_sens_selected);
+		     channel++)
+			any |= private->auto_sens_selected[channel];
+		if (!any)
+			return -EINVAL;
+		for (channel = 0; channel < ARRAY_SIZE(private->auto_sens_selected);
+		     channel++) {
+			err = roland_octa_send_byte_locked(private, 0x02, 0x01,
+				0x10 + channel, private->auto_sens_selected[channel]);
+			if (err < 0)
+				return err;
+		}
+		err = roland_octa_send_byte_locked(private, 0x02, 0x01, 0x02, 1);
+		if (err < 0)
+			return err;
+		err = roland_octa_send_byte_locked(private, 0x02, 0x01, 0x03, 1);
+		if (err < 0)
+			return err;
+		private->auto_sens_state = 1;
+	} else if (value == 2) {
+		err = roland_octa_send_byte_locked(private, 0x02, 0x01, 0x02, 2);
+		if (err < 0)
+			return err;
+		err = roland_octa_send_byte_locked(private, 0x02, 0x01, 0x03, 0);
+		if (err < 0)
+			return err;
+		private->auto_sens_state = 0;
+	} else {
+		if (!private->auto_sens_state)
+			return 0;
+		err = roland_octa_send_byte_locked(private, 0x02, 0x01, 0x02, 0);
+		if (err < 0)
+			return err;
+		private->auto_sens_state = 0;
+	}
+	msleep(25);
+	err = roland_octa_read_snapshot_locked(private);
+	return err < 0 ? err : 1;
+}
