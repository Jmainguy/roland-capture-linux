+static int roland_auto_sens_select_get(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+
+	ucontrol->value.integer.value[0] = private->auto_sens_selected[elem->control];
+	return 0;
+}
+
+static int roland_auto_sens_select_put(struct snd_kcontrol *kcontrol,
+				       struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kcontrol->private_data;
+	struct roland_capture_mixer *private = elem->head.mixer->private_data;
+	long value = ucontrol->value.integer.value[0];
+
+	if (value < 0 || value > 1)
+		return -EINVAL;
+	if (private->auto_sens_state)
+		return -EBUSY;
+	if (private->auto_sens_selected[elem->control] == value)
+		return 0;
+	private->auto_sens_selected[elem->control] = value;
+	return 1;
+}
