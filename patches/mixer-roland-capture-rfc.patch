+
+	if (value < 0 || value > 1)
+		return -EINVAL;
+	guard(mutex)(&private->request_mutex);
+	if ((elem->cmask ?
+	     private->wave_output_switch[elem->idx_off][mixer][channel] :
+	     private->direct_input_switch[elem->idx_off][mixer][channel]) == value)
+		return 0;
