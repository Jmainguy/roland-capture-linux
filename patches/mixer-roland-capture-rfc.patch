+		.access = SNDRV_CTL_ELEM_ACCESS_READ |
+			  SNDRV_CTL_ELEM_ACCESS_VOLATILE,
+		.info = roland_meter_info,
+		.get = roland_meter_get,
+		.private_value = channel | (compressor_output ? 0x100 : 0),
+	};
+	struct snd_kcontrol *kcontrol;
+
+	kcontrol = snd_ctl_new1(&control, private);
+	if (!kcontrol)
+		return -ENOMEM;
+	snprintf(kcontrol->id.name, sizeof(kcontrol->id.name),
+		 compressor_output ? "Input %d Compressor Output Meter" :
+		 "Input %d Meter", channel + 1);
+	return snd_ctl_add(private->mixer->chip->card, kcontrol);
+}
+
+static void roland_capture_free(struct usb_mixer_interface *mixer)
+{
+	struct roland_capture_mixer *private = mixer->private_data;
+
+	if (private) {
+		cancel_delayed_work_sync(&private->meter_stream_timeout);
+		usb_kill_urb(private->clock_urb);
+		usb_free_urb(private->clock_urb);
+		kfree(private->clock_buffer);
+		if (private->meter_streaming)
+			roland_octa_send_byte_locked(private, 0x0a, 0x00, 0x00, 0);
+		roland_capture_midi_close(private);
+	}
+	kfree(mixer->private_data);
+	mixer->private_data = NULL;
+}
+
+int snd_roland_capture_init(struct usb_mixer_interface *mixer)
+{
+	struct roland_capture_mixer *private;
+	struct snd_kcontrol *snapshot_control;
+	struct snd_kcontrol *device_globals_control;
+	struct snd_kcontrol *reverb_type_control;
+	struct snd_kcontrol *auto_sens_state_control;
+	struct snd_kcontrol *meter_stream_control;
+	struct snd_kcontrol *clock_control;
+	int channel;
+	int direct_mixer;
+	int err;
+
+	if (mixer->chip->usb_id != USB_ID_ROLAND_OCTA_CAPTURE)
+		return -ENODEV;
+
+	private = kzalloc_obj(*private);
+	if (!private)
+		return -ENOMEM;
+
+	private->mixer = mixer;
+	private->model_id = ROLAND_CAPTURE_MODEL_OCTA;
+	mutex_init(&private->request_mutex);
+	spin_lock_init(&private->response_lock);
+	init_completion(&private->response_ready);
+	INIT_DELAYED_WORK(&private->meter_stream_timeout,
+			  roland_meter_stream_timeout);
+	mixer->private_data = private;
+	mixer->private_free = roland_capture_free;
+	err = roland_octa_read_snapshot(private);
+	if (err < 0) {
+		roland_capture_free(mixer);
+		return err;
+	}
+	err = roland_clock_start(private);
+	if (err < 0) {
+		usb_audio_warn(mixer->chip,
+			       "OCTA clock telemetry unavailable: %d\n", err);
+	} else {
+		clock_control = snd_ctl_new1(&roland_clock_control, private);
+		if (!clock_control)
+			return -ENOMEM;
+		err = snd_ctl_add(mixer->chip->card, clock_control);
+		if (err < 0)
+			return err;
+	}
+	snapshot_control = snd_ctl_new1(&roland_snapshot_control, private);
+	if (!snapshot_control)
+		return -ENOMEM;
+	err = snd_ctl_add(mixer->chip->card, snapshot_control);
+	if (err < 0)
+		return err;
+	device_globals_control = snd_ctl_new1(&roland_device_globals_control,
+					      private);
+	if (!device_globals_control)
+		return -ENOMEM;
+	err = snd_ctl_add(mixer->chip->card, device_globals_control);
+	if (err < 0)
+		return err;
+	for (channel = 0; channel < ARRAY_SIZE(private->gain); channel++) {
+		static const char * const parameter_names[] = {
+			"Gate", "Attack", "Release", "Threshold", "Ratio",
+			"Output Gain"
+		};
+		int parameter;
+
+		err = roland_add_gain_control(private, channel);
+		if (err < 0)
+			return err;
+		err = roland_add_switch_control(private, ROLAND_SWITCH_PHANTOM,
+						channel, "Phantom Power");
+		if (err < 0)
+			return err;
+		err = roland_add_switch_control(private, ROLAND_SWITCH_LOW_CUT,
+						channel, "Low Cut");
+		if (err < 0)
+			return err;
+		err = roland_add_switch_control(private, ROLAND_SWITCH_PHASE,
+						channel, "Phase Invert");
+		if (err < 0)
+			return err;
+		err = roland_add_switch_control(private, ROLAND_SWITCH_COMPRESSOR,
+						channel, "Compressor");
+		if (err < 0)
+			return err;
+		if (channel < ARRAY_SIZE(private->high_impedance)) {
+			err = roland_add_switch_control(
+				private, ROLAND_SWITCH_HIGH_IMPEDANCE,
+				channel, "High Impedance");
+			if (err < 0)
+				return err;
+		}
+		for (parameter = 0; parameter < ARRAY_SIZE(parameter_names);
+		     parameter++) {
+			err = roland_add_parameter_control(private, parameter,
+							   channel,
+							   parameter_names[parameter]);
+			if (err < 0)
+				return err;
+		}
+		err = roland_add_meter_control(private, channel, false);
+		if (err < 0)
+			return err;
+		err = roland_add_meter_control(private, channel, true);
+		if (err < 0)
+			return err;
+	}
+	for (channel = 0; channel < ARRAY_SIZE(private->compressor_stereo_link);
+	     channel++) {
+		err = roland_add_compressor_link_control(private, channel);
+		if (err < 0)
+			return err;
+	}
+	for (direct_mixer = 0; direct_mixer < 4; direct_mixer++) {
+		static const char * const switch_names[] = {
+			"Stereo Link", "Solo", "Mute"
+		};
+		int kind;
+
+		for (channel = 0; channel < 10; channel++) {
+			for (kind = 0; kind < ARRAY_SIZE(switch_names); kind++) {
+				err = roland_add_direct_switch_control(
+					private, false, kind, direct_mixer, channel,
+					switch_names[kind]);
+				if (err < 0)
+					return err;
+				err = roland_add_direct_switch_control(
+					private, true, kind, direct_mixer, channel,
+					switch_names[kind]);
+				if (err < 0)
+					return err;
+			}
+			err = roland_add_direct_value_control(private, false,
+					ROLAND_DIRECT_PAN, direct_mixer, channel,
+					"Pan");
+			if (err < 0)
+				return err;
+			err = roland_add_direct_value_control(private, false,
+					ROLAND_DIRECT_LEVEL, direct_mixer, channel,
+					"Level");
+			if (err < 0)
+				return err;
+			err = roland_add_direct_value_control(private, true,
+					ROLAND_DIRECT_PAN, direct_mixer, channel,
+					"Pan");
+			if (err < 0)
+				return err;
+			err = roland_add_direct_value_control(private, true,
+					ROLAND_DIRECT_LEVEL, direct_mixer, channel,
+					"Level");
+			if (err < 0)
+				return err;
+			if (!direct_mixer) {
+				err = roland_add_direct_value_control(
+					private, false, ROLAND_DIRECT_REVERB_SEND,
+					direct_mixer, channel, "Reverb Send");
+				if (err < 0)
+					return err;
+			}
+		}
+		err = roland_add_master_control(private, false,
+				ROLAND_MASTER_INPUT_STEREO_LINK, direct_mixer,
+				"Input Master Stereo Link");
+		if (err < 0)
+			return err;
+		err = roland_add_master_control(private, true,
+				ROLAND_MASTER_INPUT_LEFT, direct_mixer,
+				"Input Master Left");
+		if (err < 0)
+			return err;
+		err = roland_add_master_control(private, true,
+				ROLAND_MASTER_INPUT_RIGHT, direct_mixer,
+				"Input Master Right");
+		if (err < 0)
+			return err;
+		err = roland_add_master_control(private, false,
+				ROLAND_MASTER_LINK_INPUT_OUTPUT, direct_mixer,
+				"Link Input Output Masters");
+		if (err < 0)
+			return err;
+		err = roland_add_master_control(private, false,
+				ROLAND_MASTER_OUTPUT_STEREO_LINK, direct_mixer,
+				"Output Master Stereo Link");
+		if (err < 0)
+			return err;
+		err = roland_add_master_control(private, true,
+				ROLAND_MASTER_OUTPUT_LEFT, direct_mixer,
+				"Output Master Left");
+		if (err < 0)
+			return err;
+		err = roland_add_master_control(private, true,
+				ROLAND_MASTER_OUTPUT_RIGHT, direct_mixer,
+				"Output Master Right");
+		if (err < 0)
+			return err;
+		if (!direct_mixer) {
+			err = roland_add_master_control(private, true,
+					ROLAND_MASTER_REVERB_RETURN, direct_mixer,
+					"Reverb Return");
+			if (err < 0)
+				return err;
+		}
+	}
+	for (channel = 0; channel < ARRAY_SIZE(private->patch_bay); channel++) {
+		err = roland_add_patch_bay_control(private, channel);
+		if (err < 0)
+			return err;
+	}
+	reverb_type_control = snd_ctl_new1(&roland_reverb_type_control, private);
+	if (!reverb_type_control)
+		return -ENOMEM;
+	err = snd_ctl_add(mixer->chip->card, reverb_type_control);
+	if (err < 0)
+		return err;
+	err = roland_add_reverb_parameter_control(private,
+		ROLAND_REVERB_PRE_DELAY, "Reverb Pre Delay");
+	if (err < 0)
+		return err;
+	err = roland_add_reverb_parameter_control(private,
+		ROLAND_REVERB_TIME, "Reverb Time");
+	if (err < 0)
+		return err;
+	private->auto_sens_selected[0] = true;
+	for (channel = 0; channel < ARRAY_SIZE(private->auto_sens_selected); channel++) {
+		err = roland_add_auto_sens_select_control(private, channel);
+		if (err < 0)
+			return err;
+	}
+	auto_sens_state_control = snd_ctl_new1(&roland_auto_sens_state_control, private);
+	if (!auto_sens_state_control)
+		return -ENOMEM;
+	err = snd_ctl_add(mixer->chip->card, auto_sens_state_control);
+	if (err < 0)
+		return err;
+	meter_stream_control = snd_ctl_new1(&roland_meter_stream_control, private);
+	if (!meter_stream_control)
+		return -ENOMEM;
+	err = snd_ctl_add(mixer->chip->card, meter_stream_control);
+	if (err < 0)
+		return err;
+	strscpy(mixer->chip->card->mixername, "Roland OCTA-CAPTURE");
+	usb_audio_info(mixer->chip,
+		       "Roland OCTA-CAPTURE vendor mixer initialized\n");
+
+	return 0;
+}
