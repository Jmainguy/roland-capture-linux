+/*
+ * Roland OCTA/QUAD-CAPTURE: vendor sample-rate on endpoint start (not prepare).
+ * octa_capture_autoset (default Y) lets vanilla PW/JACK set the clock; `octa`
+ * clears it around rate changes so WP 48 kHz starts do not snap the hardware.
+ */
+static bool octa_capture_autoset = true;
+module_param_named(octa_capture_autoset, octa_capture_autoset, bool, 0644);
+MODULE_PARM_DESC(octa_capture_autoset,
+		 "OCTA/QUAD-CAPTURE: set vendor sample rate when PCM endpoints start");
+
+static int octa_capture_read_rate(struct usb_device *dev, u32 *rate_ret, u8 *status_ret)
+{
+	u8 buf[4];
+	int err;
+	u32 rate;
+
+	err = snd_usb_ctl_msg(dev, usb_rcvctrlpipe(dev, 0),
+			      3, USB_DIR_IN | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			      0x0001, 0, buf, 4);
+	if (err != 4)
+		return err < 0 ? err : -EIO;
+
+	rate = buf[0] | (buf[1] << 8) | (buf[2] << 16);
+	switch (rate) {
+	case 44100:
+	case 48000:
+	case 96000:
+	case 192000:
+		break;
+	default:
+		return -EINVAL;
+	}
+	*rate_ret = rate;
+	if (status_ret)
+		*status_ret = buf[3];
+	return 0;
+}
+
+static void octa_capture_set_rate(struct snd_usb_endpoint *ep)
+{
+	struct snd_usb_audio *chip = ep->chip;
+	struct usb_device *dev = chip->dev;
+	u8 buf[4];
+	u32 new_rate = ep->cur_rate;
+	u32 cur_rate;
+	u8 status;
+	int err, i;
+
+	if (!octa_capture_autoset)
+		return;
+	if (ep->type != SND_USB_ENDPOINT_TYPE_DATA)
+		return;
+
+	switch (new_rate) {
+	case 44100:
+	case 48000:
+	case 96000:
+	case 192000:
+		break;
+	default:
+		return;
+	}
+
+	err = octa_capture_read_rate(dev, &cur_rate, &status);
+	if (err == 0 && cur_rate == new_rate)
+		return;
+
+	dev_info(&dev->dev, "Roland Capture: set sample rate to %u Hz\n", new_rate);
+
+	buf[0] = 0x40;
+	buf[1] = new_rate & 0xff;
+	buf[2] = (new_rate >> 8) & 0xff;
+	buf[3] = (new_rate >> 16) & 0xff;
+	err = snd_usb_ctl_msg(dev, usb_sndctrlpipe(dev, 0),
+			      3, USB_DIR_OUT | USB_TYPE_VENDOR | USB_RECIP_DEVICE,
+			      0x0008, 0, buf, 4);
+	if (err < 0) {
+		dev_warn(&dev->dev, "Roland Capture: set-rate failed: %d\n", err);
+		return;
+	}
+
+	/* Ready when the clock reports the target rate (status byte is unreliable). */
+	for (i = 0; i < 40; i++) {
+		err = octa_capture_read_rate(dev, &cur_rate, &status);
+		if (err == 0 && cur_rate == new_rate)
+			return;
+		msleep(25);
+	}
+}
+
 void snd_usb_endpoint_start_quirk(struct snd_usb_endpoint *ep)
 {
+	if (ep->chip->usb_id == USB_ID(0x0582, 0x0120) || /* OCTA-CAPTURE */
+	    ep->chip->usb_id == USB_ID(0x0582, 0x012f)) /* QUAD-CAPTURE */
+		octa_capture_set_rate(ep);
+
 	/*
 	 * "Playback Design" products send bogus feedback data at the start
 	 * of the stream. Ignore them.
